# =============================================================================
# SocialPulse — référentiel des variables d'environnement (phase 0)
# Noms uniquement. AUCUNE vraie valeur secrète ne doit être écrite ici ni committée.
# Sera scindé en backend/.env.example et frontend/.env.example en phase 1 (ADR-018).
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=SocialPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=UTC
APP_LOCALE=fr
FRONTEND_URL=

# --- Base de données : MySQL (Laragon en dev, 8.4 LTS en prod) --------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Session / auth SPA -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=
HASH_DRIVER=argon2id

# --- Redis / queues / cache --------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Chiffrement des tokens OAuth (clé distincte d'APP_KEY, ADR-008) ----------
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# --- Stockage des médias ------------------------------------------------------
FILESYSTEM_DISK=local
MEDIA_DISK=media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_SIGNED_URL_TTL=
MEDIA_PLATFORM_PULL_URL_TTL=
MEDIA_PUBLIC_DELIVERY_DOMAIN=

# --- Uploads / antivirus / vidéo -------------------------------------------------
UPLOAD_MAX_IMAGE_MB=
UPLOAD_MAX_VIDEO_MB=
CLAMAV_HOST=
CLAMAV_PORT=
FFMPEG_BINARY=
FFPROBE_BINARY=
FFMPEG_TIMEOUT=
VIDEO_MAX_DURATION_SECONDS=

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# --- Réseaux sociaux (APIs officielles uniquement) -----------------------------
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

# --- IA (indépendante du fournisseur, ADR-011) ---------------------------------
AI_DEFAULT_PROVIDER=
AI_TEXT_PROVIDER=
AI_TRANSCRIPTION_PROVIDER=
AI_REQUEST_TIMEOUT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observabilité ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=info
SENTRY_DSN=

# --- Frontend (Vite : seules les variables VITE_* sont exposées au navigateur) ---
# Ne JAMAIS mettre de secret dans une variable VITE_*.
VITE_API_URL=
VITE_APP_NAME=
