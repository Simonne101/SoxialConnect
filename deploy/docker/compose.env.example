# Variables de la composition Docker (deploy/docker/compose.yaml) — MODÈLE SANS SECRET.
# Sur le serveur : copier en /srv/soxialconnect/compose.env (chmod 600, hors Git), compléter chaque valeur vide.
# Générer chaque mot de passe à part, par exemple : openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# Version des images construites (tag Git ou date) et préfixe (registre privé éventuel).
SOXIAL_VERSION=
SOXIAL_IMAGE_PREFIX=soxialconnect

# Nom de domaine public (un seul domaine : SPA + API relayée par Nginx).
SERVER_NAME=soxialconnect.example.com

# Fichier .env Laravel de production (modèle : backend/.env.production.example), monté en lecture seule.
SOXIAL_ENV_FILE=/srv/soxialconnect/backend.env

# Certificats TLS (fullchain.pem, privkey.pem), par exemple ceux de certbot copiés par un hook de renouvellement.
TLS_CERT_DIR=/srv/soxialconnect/certs

# MySQL : mêmes valeurs que DB_DATABASE / DB_USERNAME / DB_PASSWORD du .env Laravel (DB_HOST=mysql).
MYSQL_DATABASE=sociopulse
MYSQL_USER=sociopulse
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis : même valeur que REDIS_PASSWORD du .env Laravel (REDIS_HOST=redis).
REDIS_PASSWORD=
