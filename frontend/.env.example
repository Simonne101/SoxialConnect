# Frontend SoxialConnect — variables exposées au navigateur (préfixe VITE_ obligatoire).
# NE JAMAIS placer de secret ici : tout ce qui commence par VITE_ est lisible par l'utilisateur.

# URL de l'API Laravel (phase backend). Non utilisée tant que les données sont simulées.
VITE_API_URL=
VITE_APP_NAME=SoxialConnect

# Développement derrière un tunnel HTTPS (TikTok exige une redirect URI en https) :
# nom d'hôte seul, sans https:// ni chemin (ex. mon-tunnel.ngrok-free.dev). Seul hôte ajouté à
# server.allowedHosts dans vite.config.ts. Pas un secret. Laisser vide sans tunnel.
VITE_DEV_TUNNEL_HOST=
