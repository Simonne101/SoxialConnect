# =============================================================================
# SocialPulse — backend Laravel. Noms de variables et valeurs non sensibles uniquement.
# Copier en .env (jamais versionné) puis renseigner les secrets localement.
# =============================================================================

APP_NAME=SocialPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# URL de la SPA React (CORS, liens des e-mails, redirections).
FRONTEND_URL=http://localhost:5173

# --- Logs structurés (JSON) avec masquage des secrets ------------------------
LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL (Laragon en dev : 8.0.30 ; production : 8.4 LTS) ------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sociopulse
DB_USERNAME=sociopulse
DB_PASSWORD=

# --- Session (SPA Sanctum, cookie HttpOnly) -----------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# En local, frontend (localhost:5173) et API (localhost:8000) partagent le domaine « localhost ».
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Sanctum / CORS -----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Mots de passe : Argon2id (docs/security.md §3) ---------------------------
HASH_DRIVER=argon2id

# --- Redis (jamais exposé sur Internet) ---------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Chiffrement des tokens OAuth : clé dédiée, distincte d'APP_KEY (ADR-008) ---
# Générer : php -r "echo 'base64:'.base64_encode(random_bytes(32));"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# Anciennes clés (rotation) : liste « version:base64:... » séparée par des virgules.
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# --- Administration (Gate « admin ») -------------------------------------------
ADMIN_EMAILS=

# --- Démonstration (développement local uniquement) ----------------------------
# Compte déjà inscrit qui reçoit les comptes sociaux fictifs :
# php artisan db:seed --class=DemoSocialAccountsSeeder
DEMO_SEED_EMAIL=

# --- File d'attente (ADR-037) ---------------------------------------------------
# retry_after doit rester SUPÉRIEUR au timeout le plus long d'un job (ProcessMediaJob : 300 s),
# sinon un job encore en cours est redonné à un autre worker (double exécution).
REDIS_QUEUE_RETRY_AFTER=360
# true : un job envoyé dans une transaction n'est poussé qu'après sa validation.
REDIS_QUEUE_AFTER_COMMIT=true
# Après tout changement de code : php artisan queue:restart (les workers gardent l'ancien code en mémoire).

# --- Médiathèque (docs/security.md §7) -------------------------------------------
MEDIA_DISK=media
# Antivirus : aucun moteur installé en local (ClamAV : phase ultérieure).
# MEDIA_SCAN_REQUIRED=true refuse les imports tant qu'aucun moteur n'est disponible (production).
MEDIA_SCAN_DRIVER=none
MEDIA_SCAN_REQUIRED=false
# true = traitement (réencodage, vignettes) par ProcessMediaJob sur la queue « media » (worker requis).
MEDIA_PROCESS_ASYNC=false
MEDIA_URL_TTL_MINUTES=15
MEDIA_PURGE_AFTER_DAYS=30
MEDIA_MAX_IMAGE_MB=20
MEDIA_MAX_VIDEO_MB=1024
MEDIA_MAX_AUDIO_MB=200
MEDIA_MAX_DOCUMENT_MB=25
RATE_LIMIT_MEDIA_FILES_PER_MINUTE=600

# --- Limites de débit (docs/security.md §12) ------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AUTH_SENSITIVE_PER_MINUTE=3
RATE_LIMIT_AUTH_SENSITIVE_PER_HOUR=20
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AI_PER_DAY=300
RATE_LIMIT_PUBLISH_PER_HOUR=60
RATE_LIMIT_OAUTH_PER_HOUR=10
RATE_LIMIT_WEBHOOKS_PER_MINUTE=600

# --- Mail (dev : journal) -------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Réseaux sociaux : placeholders, NE PAS renseigner avant les phases dédiées ---
META_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=
# TikTok (Login Kit Web + Content Posting API) : docs/publishing.md §12. URI de retour EN HTTPS,
# identique dans le portail TikTok (ex. https://<domaine-du-tunnel>/oauth/tiktok/callback).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# YouTube (Google OAuth 2.0) : docs/publishing.md §11. URI de retour EXACTE, déclarée dans Google Cloud.
# Local : YOUTUBE_REDIRECT_URI=http://localhost:5173/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Telegram (Bot API, bot partagé) : docs/publishing.md §13. Token fourni par @BotFather (secret :
# jamais dans Git ni dans le frontend). Nom du bot sans « @ ». Secret du webhook : 32 à 64
# caractères aléatoires [A-Za-z0-9_-]. URL HTTPS publique du webhook (local : via le tunnel), ex.
# TELEGRAM_WEBHOOK_URL=https://<domaine-du-tunnel>/api/v1/webhooks/telegram
# puis : php artisan telegram:webhook --set
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

# --- IA (fournisseur interchangeable, phase dédiée) ------------------------------
AI_DEFAULT_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Stockage objet (production) --------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Proxies de confiance (X-Forwarded-*) : par défaut le proxy local uniquement (Vite en dev, Nginx local en prod).
# Jamais « * ». Exemple : TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES=
