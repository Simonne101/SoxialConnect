# =============================================================================
# SocialPulse — backend Laravel. Noms de variables et valeurs non sensibles uniquement.
# Copier en .env (jamais versionné) puis renseigner les secrets localement.
# =============================================================================

APP_NAME=SocialPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# URL de la SPA React (CORS, liens des e-mails, redirections).
FRONTEND_URL=http://localhost:5173

# --- Logs structurés (JSON) avec masquage des secrets ------------------------
LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL (Laragon en dev : 8.0.30 ; production : 8.4 LTS) ------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sociopulse
DB_USERNAME=sociopulse
DB_PASSWORD=

# --- Session (SPA Sanctum, cookie HttpOnly) -----------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# En local, frontend (localhost:5173) et API (localhost:8000) partagent le domaine « localhost ».
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Sanctum / CORS -----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Mots de passe : Argon2id (docs/security.md §3) ---------------------------
HASH_DRIVER=argon2id

# --- Redis (jamais exposé sur Internet) ---------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Chiffrement des tokens OAuth : clé dédiée, distincte d'APP_KEY (ADR-008) ---
# Générer : php -r "echo 'base64:'.base64_encode(random_bytes(32));"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# Anciennes clés (rotation) : liste « version:base64:... » séparée par des virgules.
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# --- Administration (Gate « admin ») -------------------------------------------
ADMIN_EMAILS=

# --- Démonstration (développement local uniquement) ----------------------------
# Compte déjà inscrit qui reçoit les comptes sociaux fictifs :
# php artisan db:seed --class=DemoSocialAccountsSeeder
DEMO_SEED_EMAIL=

# --- File d'attente (ADR-037) ---------------------------------------------------
# retry_after doit rester SUPÉRIEUR au timeout le plus long d'un job (ProcessMediaJob : 300 s),
# sinon un job encore en cours est redonné à un autre worker (double exécution).
REDIS_QUEUE_RETRY_AFTER=360
# true : un job envoyé dans une transaction n'est poussé qu'après sa validation.
REDIS_QUEUE_AFTER_COMMIT=true
# Connexion « redis-video » (rendus vidéo, ADR-042) : retry_after SUPÉRIEUR à VIDEO_RENDER_TIMEOUT.
# Worker : php artisan queue:work redis-video --queue=video --timeout=1800 (jamais sur « redis »).
REDIS_VIDEO_QUEUE_RETRY_AFTER=1900
# Après tout changement de code : php artisan queue:restart (les workers gardent l'ancien code en mémoire).

# --- Médiathèque (docs/security.md §7) -------------------------------------------
MEDIA_DISK=media
# Antivirus (ADR-073) : « clamav » = démon clamd (INSTREAM, TCP ou socket Unix) ; « none » = aucune analyse.
# MEDIA_SCAN_REQUIRED=true refuse les imports tant qu'aucun moteur n'est joignable (production).
# Mise en service sur une base existante : php artisan media:scan-pending (analyse les médias « non analysés »).
MEDIA_SCAN_DRIVER=none
MEDIA_SCAN_REQUIRED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# CLAMAV_SOCKET=/run/clamav/clamd.sock
CLAMAV_SCAN_TIMEOUT=300
# true = traitement (réencodage, vignettes) par ProcessMediaJob sur la queue « media » (worker requis).
MEDIA_PROCESS_ASYNC=false
MEDIA_URL_TTL_MINUTES=15
MEDIA_PURGE_AFTER_DAYS=30
MEDIA_MAX_IMAGE_MB=20
MEDIA_MAX_VIDEO_MB=1024
MEDIA_MAX_AUDIO_MB=200
MEDIA_MAX_DOCUMENT_MB=25
RATE_LIMIT_MEDIA_FILES_PER_MINUTE=600

# --- Limites de débit (docs/security.md §12) ------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Verrouillage progressif (adresse + IP, par heure) et plafonds par IP (credential stuffing), code 2FA (ADR-073).
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_LOGIN_IP_PER_MINUTE=20
RATE_LIMIT_LOGIN_IP_PER_HOUR=100
RATE_LIMIT_TWO_FACTOR_PER_MINUTE=5
# Taille maximale d'un corps JSON (Ko) : 413 au-delà.
API_MAX_JSON_KB=1024
RATE_LIMIT_AUTH_SENSITIVE_PER_MINUTE=3
RATE_LIMIT_AUTH_SENSITIVE_PER_HOUR=20
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AI_PER_DAY=300
RATE_LIMIT_PUBLISH_PER_HOUR=60
RATE_LIMIT_OAUTH_PER_HOUR=10
RATE_LIMIT_WEBHOOKS_PER_MINUTE=600

# --- Mail (dev : journal) -------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Réseaux sociaux ---
# Facebook — Pages (Facebook Login + API Graph) : docs/publishing.md §16. ID et clé secrète de l'app Meta
# (Paramètres de l'app → Général). URI de retour EXACTE déclarée dans l'app (Facebook Login → URI de
# redirection OAuth valides), ex. https://<domaine>/oauth/facebook/callback. FACEBOOK_LOGIN_CONFIG_ID :
# configuration « Facebook Login for Business » si l'app l'impose (vide = scopes demandés directement).
META_APP_ID=
META_APP_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v23.0
# Instagram — comptes professionnels (API Instagram avec connexion Instagram) : docs/publishing.md §17.
# ID et clé secrète de l'app INSTAGRAM (cas d'usage Instagram → Configuration de l'API avec connexion
# Instagram), distincts de ceux de l'app Meta. URI de retour : https://<domaine>/oauth/instagram/callback.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_VERSION=v23.0
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=
# TikTok (Login Kit Web + Content Posting API) : docs/publishing.md §12. URI de retour EN HTTPS,
# identique dans le portail TikTok (ex. https://<domaine-du-tunnel>/oauth/tiktok/callback).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# YouTube (Google OAuth 2.0) : docs/publishing.md §11. URI de retour EXACTE, déclarée dans Google Cloud.
# Local : YOUTUBE_REDIRECT_URI=http://localhost:5173/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Telegram (Bot API, bot partagé) : docs/publishing.md §13. Token fourni par @BotFather (secret :
# jamais dans Git ni dans le frontend). Nom du bot sans « @ ». Secret du webhook : 32 à 64
# caractères aléatoires [A-Za-z0-9_-]. URL HTTPS publique du webhook (local : via le tunnel), ex.
# TELEGRAM_WEBHOOK_URL=https://<domaine-du-tunnel>/api/v1/webhooks/telegram
# puis : php artisan telegram:webhook --set
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# LinkedIn (Sign In with LinkedIn using OpenID Connect + Share on LinkedIn) : docs/publishing.md §14.
# URI de retour HTTPS EXACTE, déclarée dans le LinkedIn Developer Portal (onglet Auth), ex.
# LINKEDIN_REDIRECT_URI=https://<domaine-du-tunnel>/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=
# X (OAuth 2.0 + PKCE, application de type « Web App » = client confidentiel) : docs/publishing.md §15.
# Console développeur X → User authentication settings : permissions « Read and write », Callback
# URI EXACTE (« localhost » refusé par X), ex.
# X_REDIRECT_URI=https://<domaine-du-tunnel>/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

# --- IA (config/ai.php, ADR-011 / ADR-042 / ADR-043) -------------------------------
# Fournisseur officiel : OpenAI (API Responses, client HTTP Laravel, sans SDK). Seul « openai » est
# implémenté ; vide = IA désactivée. Aucune génération métier n'existe encore.
AI_DEFAULT_PROVIDER=openai
# Clé API : secret, UNE seule ligne, uniquement ici (jamais dans Git, jamais côté frontend).
# Vérification réelle de la connexion : php artisan ai:check (requête minimale, rien n'est enregistré).
OPENAI_API_KEY=
# Autres fournisseurs : prévus par la configuration, non implémentés.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Modèle par défaut, et modèle propre à une tâche si besoin (AI_MODEL_IDEAS, AI_MODEL_POST,
# AI_MODEL_CAPTION, AI_MODEL_HASHTAGS, AI_MODEL_REPHRASE, AI_MODEL_TONE, AI_MODEL_ADAPT, AI_MODEL_SCRIPT,
# AI_MODEL_VIDEO_ANALYSIS pour le choix des passages du YouTube Clipper).
# Vide : aucun modèle choisi (ai:check utilise alors un modèle de test, voir la commande).
AI_DEFAULT_MODEL=
# Modèles spécialisés (ADR-046), JAMAIS déduits de AI_DEFAULT_MODEL. Vides : fonction non configurée.
# Transcription horodatée du YouTube Clipper (OpenAI : un modèle acceptant verbose_json + segments).
AI_MODEL_TRANSCRIPTION=
# Génération d'images (OpenAI : modèle d'images renvoyant l'image en base64).
AI_MODEL_IMAGE=
# Fournisseur propre à une tâche (vide = AI_DEFAULT_PROVIDER) : openai | gemini.
# Gemini : analyse (y compris directement depuis un lien YouTube public) et images ; PAS de transcription.
AI_VIDEO_ANALYSIS_PROVIDER=
# Analyse depuis un lien YouTube : fournisseur dédié (capacité « lien vidéo », ex. gemini) ; vide = AI_VIDEO_ANALYSIS_PROVIDER.
AI_VIDEO_URL_ANALYSIS_PROVIDER=
# Modèle de secours de l'analyse par lien (même fournisseur), essayé UNE fois si le principal est indisponible
# (quota, surcharge, délai) ; tracé et signalé. Vide = aucun secours. Ex. : gemini-3.1-flash-lite
AI_VIDEO_URL_ANALYSIS_FALLBACK_MODEL=
# Budget de sortie de l’analyse (les modèles « à réflexion » en consomment une partie).
AI_VIDEO_ANALYSIS_MAX_OUTPUT_TOKENS=8000
AI_TRANSCRIPTION_PROVIDER=
AI_IMAGE_PROVIDER=
# Google Gemini (API Interactions, ADR-048) : clé du projet Google AI Studio (jamais commitée).
# Modèles propres à Gemini, utilisés quand une tâche lui est confiée (ex. gemini-3.8-flash pour
# l'analyse, gemini-3.1-flash-image pour les images : vérifier la liste officielle des modèles).
GEMINI_MODEL_ANALYSIS=
GEMINI_MODEL_IMAGE=
GEMINI_VIDEO_TIMEOUT=300
GEMINI_IMAGE_SIZE=1K
# Délais (s) : transcription d'une longue vidéo, génération d'une image.
AI_TRANSCRIPTION_TIMEOUT=600
AI_IMAGE_TIMEOUT=180
# Tailles demandées au fournisseur, puis recadrage au format choisi (1:1, 4:5, 9:16, 16:9).
AI_IMAGE_SIZE_SQUARE=1024x1024
AI_IMAGE_SIZE_PORTRAIT=1024x1536
AI_IMAGE_SIZE_LANDSCAPE=1536x1024
# Délai maximal d'un appel (s), longueur maximale d'une entrée (caractères).
AI_TIMEOUT=60
AI_MAX_INPUT_CHARS=8000
# Budget quotidien estimé par utilisateur, en millionièmes de AI_BUDGET_CURRENCY (vide = sans plafond).
AI_DAILY_BUDGET_MICROS_PER_USER=
AI_BUDGET_CURRENCY=USD
# Cache des générations identiques.
AI_CACHE_ENABLED=true
AI_CACHE_TTL_HOURS=24

# --- Video Studio et YouTube Clipper (config/video.php, ADR-042, ADR-045, ADR-046) ---
# Rendus MP4 par FFmpeg (worker « video », connexion redis-video). Sans FFmpeg, l'application démarre
# et chaque rendu échoue proprement (RENDERER_UNAVAILABLE).
# Binaires : nom dans le PATH ou chemin absolu. Sous Windows, préférer le chemin absolu (barres
# obliques) : un PATH modifié n'est vu que des processus lancés APRÈS la modification, ex.
# VIDEO_FFMPEG_BINARY="C:/Program Files/ffmpeg/bin/ffmpeg.exe"
VIDEO_FFMPEG_BINARY=ffmpeg
VIDEO_FFPROBE_BINARY=ffprobe
# Délai de détection des binaires (s) : un premier lancement peut être lent (antivirus).
VIDEO_BINARY_CHECK_TIMEOUT=20
# Police des textes (TTF). Vide : Arial (Windows) ou DejaVu Sans (Linux) si présentes.
VIDEO_FONT_FILE=
# Encodage H.264 : preset (ultrafast … veryslow) et qualité CRF (18 = très bonne, 23 = défaut x264).
VIDEO_X264_PRESET=veryfast
VIDEO_X264_CRF=20
# Délai maximal d'une analyse FFprobe (s) : borne un blocage ; 30 s insuffisants sous forte charge.
VIDEO_PROBE_TIMEOUT=120
# Statistiques (ADR-063) : file dédiée, fenêtres de collecte, intervalle minimal entre deux collectes
# réussies d'un même élément, conservation des réponses brutes (métriques normalisées conservées).
ANALYTICS_QUEUE=analytics
ANALYTICS_ACCOUNT_WINDOW_DAYS=30
ANALYTICS_POST_WINDOW_DAYS=90
ANALYTICS_MIN_INTERVAL_SECONDS=3600
ANALYTICS_RAW_RETENTION_MONTHS=13
RATE_LIMIT_ANALYTICS_SYNC_PER_HOUR=20
# Statistiques X (ADR-067) : chaque lecture de l'API X est facturée ; false = aucun appel (ni manuel ni
# planifié). Activer seulement après accord et vérification des crédits du compte développeur X.
ANALYTICS_X_ENABLED=false
# Statistiques LinkedIn (ADR-067) : en-tête Linkedin-Version (AAAAMM) des API /rest ; à mettre à jour avant
# le retrait annoncé par LinkedIn. Aucun appel tant que le scope r_member_postAnalytics n'est pas accordé.
ANALYTICS_LINKEDIN_API_VERSION=202609
# Dossier de travail des rendus (vide = storage/app/private/tmp/video, sur le disque du projet).
VIDEO_TEMP_PATH=
VIDEO_TEMP_RETENTION_HOURS=24
# Limites V1 d'un projet.
VIDEO_MAX_DURATION_MS=90000
VIDEO_MAX_SCENES=20
VIDEO_MAX_TRACKS=8
VIDEO_MAX_ITEMS_PER_TRACK=100
VIDEO_MAX_ASSETS=100
VIDEO_DEFAULT_FPS=30
# Durée maximale d'un rendu (s) : doit rester INFÉRIEURE à REDIS_VIDEO_QUEUE_RETRY_AFTER.
VIDEO_RENDER_TIMEOUT=1800
# YouTube Clipper : passages proposés, durée maximale d'une source analysée (minutes), longueur
# maximale de la transcription transmise au modèle. Un clip ne dépasse JAMAIS 60 s (non réglable).
CLIPPER_SUGGESTIONS=5
CLIPPER_MAX_SOURCE_MINUTES=120
CLIPPER_MAX_TRANSCRIPT_CHARS=120000
# Clipper sans IA obligatoire (ADR-047). Transcription : auto (whisper.cpp local s'il est installé,
# sinon IA si configurée, sinon aucune) | local | ai | none. Analyse : auto (IA si configurée, sinon
# analyse locale sans IA) | ai | local | none. Le passage manuel fonctionne dans tous les cas.
CLIPPER_TRANSCRIPTION=auto
CLIPPER_ANALYSIS=auto
# whisper.cpp (transcription locale gratuite) : vides = storage/app/whisper/bin/Release/whisper-cli.exe
# et storage/app/whisper/models/ggml-base.bin. Langue : auto ou code ISO (fr, en…).
WHISPER_CPP_BINARY=
WHISPER_CPP_MODEL=
WHISPER_CPP_LANGUAGE=auto
WHISPER_CPP_THREADS=4
# Durée maximale transcrite localement (minutes) et délai maximal (s).
WHISPER_CPP_MAX_MINUTES=20
WHISPER_CPP_TIMEOUT=1500

# Acquisition de la source vidéo du Clipper (ADR-049) : uniquement par des voies AUTORISÉES, jamais
# de téléchargement YouTube. Taille maximale (octets) et conservation (jours) des fichiers acquis
# automatiquement ; nombre maximal de relances d'un fournisseur en attente.
CLIPPER_SOURCE_MAX_BYTES=4294967296
CLIPPER_SOURCE_RETENTION_DAYS=7
CLIPPER_SOURCE_MAX_ATTEMPTS=30
# Réutiliser le fichier de la même vidéo déjà fourni dans un autre projet (sans copie ni import).
CLIPPER_REUSE_LIBRARY=true
# Clip Intelligence Engine (ADR-051) : seuil de déduplication des passages (part du plus court qui
# se chevauche au-delà de laquelle deux passages sont des doublons). Poids du score : config/video.php.
CLIPPER_DEDUPE_OVERLAP=0.5
# Composition des clips (ADR-052) : remotion (FFmpeg découpe et recadre, Remotion compose accroche et
# sous-titres) ou ffmpeg (moteur FFmpeg seul). Accroche de l'IA affichée en début de clip.
CLIPPER_COMPOSER=remotion
CLIPPER_SHOW_HOOK=true
# Échec de Remotion : repli sur le rendu FFmpeg seul (sous-titres, sans accroche). false = le clip échoue.
CLIPPER_REMOTION_FALLBACK=true
# Double envoi d'une même demande de projet (secondes) : le projet déjà créé est renvoyé. 0 = désactivé.
CLIPPER_CREATE_DEDUPE_SECONDS=10
# yt-dlp (ADR-059) : récupération d'une vidéo YouTube PUBLIQUE ou non répertoriée dont l'utilisateur
# atteste détenir les droits. Désactivé par défaut (les conditions de YouTube restreignent le
# téléchargement). Aucun cookie ni compte. Exécutable autonome officiel
# (github.com/yt-dlp/yt-dlp/releases, empreinte SHA-256 vérifiée) ; vide = storage/app/yt-dlp/yt-dlp(.exe).
# Contrôle : php artisan clipper:ytdlp-check (et config:show video.sources.yt_dlp). Dev (queue:listen,
# config non mise en cache) : effet immédiat ; config en cache : config:clear puis queue:restart.
CLIPPER_YTDLP_ENABLED=false
YT_DLP_BINARY=
YT_DLP_TIMEOUT=1200
YT_DLP_SOCKET_TIMEOUT=30
# Délai (s) de la vérification `yt-dlp --version` (décompression de l'exécutable à chaque lancement).
YT_DLP_CHECK_TIMEOUT=60
YT_DLP_MAX_HEIGHT=1080
YT_DLP_JS_RUNTIME=node
# Composition Remotion du Clipper (paquet renderer/, ADR-051). REMOTION_BROWSER_EXECUTABLE : Chrome
# installé localement (sinon Remotion télécharge son navigateur). Licence : gratuite jusqu'à
# 3 salariés, licence entreprise au-delà (remotion.dev/license).
REMOTION_RENDERER_PATH=
REMOTION_NODE_BINARY=node
REMOTION_BROWSER_EXECUTABLE=
# Onglets de rendu parallèles : 1 sur un poste à 8 Go (mesuré : 2 et 3 onglets plus lents, mémoire saturée).
REMOTION_CONCURRENCY=1
# Moteur graphique de Chrome (angle = GPU sous Windows, ~8 % plus rapide mesuré) ; vide = défaut de Remotion.
REMOTION_GL=
REMOTION_TIMEOUT=1500
# Délai de chaque étape Remotion en secondes (démarrage de Chrome, extraction d'une image) ; 30 s chez Remotion.
REMOTION_STEP_TIMEOUT=120
# Google Data Portability API (ADR-054) : export officiel des vidéos DE LA CHAÎNE du propriétaire
# (comptes Google EEE / Suisse / Royaume-Uni). Prérequis Google Cloud : API « Data Portability »
# activée, scopes dataportability.youtube.* ajoutés à l'écran de consentement, redirect URI déclarée,
# compte ajouté aux utilisateurs de test (mode Testing : autorisation valable 7 jours).
# Client OAuth : celui de YouTube si les deux variables ci-dessous restent vides.
# Local : DATA_PORTABILITY_REDIRECT_URI=http://localhost:5173/oauth/data-portability/callback
DATA_PORTABILITY_ENABLED=false
DATA_PORTABILITY_CLIENT_ID=
DATA_PORTABILITY_CLIENT_SECRET=
DATA_PORTABILITY_REDIRECT_URI=
DATA_PORTABILITY_RESOURCES=youtube.public_videos,youtube.unlisted_videos
DATA_PORTABILITY_POLL_SECONDS=300
DATA_PORTABILITY_ARCHIVE_MAX_BYTES=21474836480
DATA_PORTABILITY_DOWNLOAD_TIMEOUT=1500

# --- Stockage objet (production) --------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Proxies de confiance (X-Forwarded-*) : par défaut le proxy local uniquement (Vite en dev, Nginx local en prod).
# Jamais « * ». Exemple : TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES=
# Quotas de sécurité (ADR-071) — 0 désactive le quota correspondant (déconseillé en production).
# Stockage par utilisateur (originaux + dérivés, médias supprimés compris jusqu'à leur purge) :
QUOTA_STORAGE_MB=10240
QUOTA_RENDER_RESERVE_MB=300
QUOTA_ACQUISITION_MIN_MB=50
QUOTA_RESERVATION_TTL_MINUTES=240
# Clipping par utilisateur : projets en cours de traitement, créations sur 24 h glissantes.
QUOTA_CLIPPING_ACTIVE=5
QUOTA_CLIPPING_PER_DAY=20
QUOTA_CLIPPING_STALE_MINUTES=240
# Espace disque global : seuil minimal restant après chaque opération et marge sur sa taille.
DISK_GUARD_ENABLED=true
DISK_GUARD_MIN_FREE_MB=2048
DISK_GUARD_MARGIN_PERCENT=20
DISK_GUARD_ANALYSIS_RESERVE_MB=512
DISK_GUARD_RENDER_RESERVE_MB=2048
DISK_GUARD_UNKNOWN_DOWNLOAD_MB=4096
