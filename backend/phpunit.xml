<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Argon2id conservé, avec un coût réduit pour la vitesse des tests. -->
        <env name="HASH_DRIVER" value="argon2id"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="LOG_STACK" value="single"/>
        <env name="SESSION_DOMAIN" value="null"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173"/>
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:5173"/>
        <env name="FRONTEND_URL" value="http://localhost:5173"/>
        <env name="TOKEN_ENCRYPTION_KEY" value="base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="/>
        <env name="TOKEN_ENCRYPTION_KEY_VERSION" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Base MySQL dédiée aux tests : les contraintes (CHECK, colonnes générées, index) sont réellement testées. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="sociopulse_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
