# =====================================================================================================================
# SoxialConnect — modèle de configuration de PRODUCTION (étape 8, lot 3 — ADR-072)
#
# - Copier en .env sur le serveur, compléter chaque valeur vide, puis :
#     php artisan config:cache && php artisan security:check-production
#   La commande doit réussir (aucun « ÉCHEC ») avant toute mise en ligne.
# - AUCUN secret dans ce fichier ni dans Git : générer des valeurs PROPRES à la production (jamais celles du dev).
#     APP_KEY              : php artisan key:generate --show
#     TOKEN_ENCRYPTION_KEY : php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
# - Variables non listées ici : valeurs par défaut de config/*.php (voir .env.example pour la liste complète).
# =====================================================================================================================

APP_NAME=SoxialConnect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# HTTPS obligatoire (URL signées, liens des e-mails, cookies Secure).
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
APP_TIMEZONE=UTC
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# --- Journaux : JSON quotidien expurgé (ADR-070), pas de niveau debug ------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# --- Base de données (utilisateur dédié, droits minimaux, réseau privé) ----------------------------------------------
DB_CONNECTION=mysql
# Docker (compose.yaml) : DB_HOST=mysql.
DB_HOST=
DB_PORT=3306
DB_DATABASE=sociopulse
DB_USERNAME=
DB_PASSWORD=

# --- Sessions et cookies (SPA Sanctum) -------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Domaine parent partagé par l'API et le SPA (ex. .example.com), sinon vide.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Domaine(s) du SPA uniquement — jamais localhost, 127.0.0.1 ni tunnel de développement.
SANCTUM_STATEFUL_DOMAINS=app.example.com
# URL HTTPS du SPA uniquement — jamais « * ».
CORS_ALLOWED_ORIGINS=https://app.example.com
HASH_DRIVER=argon2id

# --- Reverse proxy : adresse ou plage du proxy (Nginx, répartiteur) — jamais « * » ---------------------------------
# Docker (deploy/docker) : Nginx parle à PHP-FPM en FastCGI et transmet lui-même l'IP du client et HTTPS=on ;
# laisser vide, sauf si un autre proxy (répartiteur, CDN) précède Nginx : indiquer alors SON adresse ou sa plage.
TRUSTED_PROXIES=

# --- Limites de l'API (ADR-073) ----------------------------------------------------------------------------------------
API_MAX_JSON_KB=1024
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_LOGIN_IP_PER_MINUTE=20
RATE_LIMIT_LOGIN_IP_PER_HOUR=100

# --- Redis : cache, verrous (quotas, jetons, publication), files — un seul Redis partagé par tous les serveurs -------
# Client PHP pur (predis, dépendance du projet) : aucune extension Redis à compiler. Docker : REDIS_HOST=redis.
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Chiffrement des jetons OAuth (clé dédiée, distincte d'APP_KEY, sauvegardée À PART des dumps) --------------------
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# --- E-mails (vérification d'adresse, réinitialisation) : jamais « log » en production ------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SoxialConnect

# --- Médias : antivirus obligatoire, traitement asynchrone -----------------------------------------------------------
MEDIA_DISK=media
# Antivirus ClamAV (démon clamd, ADR-073). Docker : CLAMAV_HOST=clamav. Démon injoignable = imports refusés (échec fermé).
MEDIA_SCAN_DRIVER=clamav
MEDIA_SCAN_REQUIRED=true
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT=300
MEDIA_PROCESS_ASYNC=true
MEDIA_URL_TTL_MINUTES=15
MEDIA_PURGE_AFTER_DAYS=30

# --- Quotas de sécurité (ADR-071) ------------------------------------------------------------------------------------
QUOTA_STORAGE_MB=10240
QUOTA_CLIPPING_ACTIVE=5
QUOTA_CLIPPING_PER_DAY=20
DISK_GUARD_ENABLED=true
DISK_GUARD_MIN_FREE_MB=2048
DISK_GUARD_MARGIN_PERCENT=20

# --- Réseaux sociaux : identifiants de l'application de PRODUCTION, URI de retour en HTTPS ---------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://app.example.com/oauth/youtube/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://app.example.com/oauth/linkedin/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://app.example.com/oauth/x/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app.example.com/oauth/tiktok/callback
# Telegram : jeton du bot de PRODUCTION et secret du webhook obligatoires ensemble.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://api.example.com/api/v1/webhooks/telegram

# --- Fonctions désactivées par défaut (activation = décision explicite) ----------------------------------------------
ANALYTICS_X_ENABLED=false
CLIPPER_YTDLP_ENABLED=false
DATA_PORTABILITY_ENABLED=false

# --- Stockage objet (si MEDIA_DISK pointe vers S3) -------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
